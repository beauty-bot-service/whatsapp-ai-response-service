# =========================
# App / Runtime
# =========================
PORT=8080
BEAUTY_BOT_INTERNAL_API_KEY_ENABLED=true
BEAUTY_BOT_INTERNAL_API_KEY_HEADER=Authorization
BEAUTY_BOT_INTERNAL_API_KEY=

# =========================
# Build-time (GitHub Packages)
# =========================
GITHUB_USERNAME=
GITHUB_TOKEN=

# =========================
# Database
# =========================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/beautybot
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# =========================
# AI (OpenAI)
# =========================
BEAUTY_BOT_AI_ENABLED=false
BEAUTY_BOT_AI_DECISION_ENABLED=false
BEAUTY_BOT_AI_DECISION_FALLBACK_ENABLED=true
OPENAI_API_KEY=
# Prompt template de OpenAI para decision conversacional.
# Requerido cuando BEAUTY_BOT_AI_ENABLED=true y BEAUTY_BOT_AI_DECISION_ENABLED=true.
# El backend usa prompt.id + conversation_context; las reglas viven en el template.
BEAUTY_BOT_AI_DECISION_PROMPT_ID=
BEAUTY_BOT_AI_DECISION_PROMPT_VERSION=
# Opcional: in_memory (default OpenAI) o 24h
BEAUTY_BOT_AI_PROMPT_CACHE_RETENTION=

# =========================
# WhatsApp Cloud API (Meta)
# =========================
WHATSAPP_ENABLED=true
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BASE_URL=https://graph.facebook.com/v25.0
BEAUTY_BOT_ADVISOR_NOTIFICATION_ENABLED=true
BEAUTY_BOT_ADVISOR_NOTIFICATION_PHONE_NUMBER=

# =========================
# Bot capabilities
# =========================
BEAUTY_BOT_CAN_CHECK_AVAILABILITY=true

# =========================
# Google Calendar
# =========================
BEAUTY_BOT_CALENDAR_ENABLED=true
BEAUTY_BOT_CALENDAR_TIME_ZONE=America/Argentina/Buenos_Aires
BEAUTY_BOT_CALENDAR_LOOKAHEAD_DAYS=14
BEAUTY_BOT_CALENDAR_SLOT_DURATION_MINUTES=30
BEAUTY_BOT_CALENDAR_MINIMUM_NOTICE_MINUTES=120
BEAUTY_BOT_CALENDAR_MAX_SUGGESTIONS=3
BEAUTY_BOT_CALENDAR_WORKING_DAYS=MONDAY,TUESDAY,WEDNESDAY,THURSDAY,FRIDAY
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Alternativa no recomendada:
# GOOGLE_SERVICE_ACCOUNT_JSON=
