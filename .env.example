# =========================
# App / Runtime
# =========================
PORT=8081
BEAUTY_BOT_CLINIC_NAME=Doctor Beauty
BEAUTY_BOT_CLINIC_ID=1
BEAUTY_BOT_LOCATION=Cochabamba 427
BEAUTY_BOT_OPENING_HOURS=Lunes a viernes de 9 a 18 hs
BEAUTY_BOT_ATTENDING_DOCTOR=Dra. Nombre Apellido
BEAUTY_BOT_TEST_ENDPOINTS_ENABLED=false
BEAUTY_BOT_INTERNAL_API_KEY_ENABLED=true
BEAUTY_BOT_INTERNAL_API_KEY_HEADER=Authorization
BEAUTY_BOT_INTERNAL_API_KEY=
BEAUTY_BOT_MASK_PHONE_NUMBERS=true
BEAUTY_BOT_ADMIN_ENABLED=true
BEAUTY_BOT_ADMIN_BOOTSTRAP_EMAIL=
BEAUTY_BOT_ADMIN_BOOTSTRAP_PASSWORD=
BEAUTY_BOT_ADMIN_SECURE_COOKIE=false

# =========================
# Build-time (GitHub Packages)
# =========================
GITHUB_USERNAME=
GITHUB_TOKEN=

# =========================
# Database
# =========================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/beautybot
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_FLYWAY_ENABLED=true
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# =========================
# AI (OpenAI)
# =========================
BEAUTY_BOT_AI_ENABLED=false
BEAUTY_BOT_AI_BASE_URL=https://api.openai.com/v1
BEAUTY_BOT_AI_DECISION_ENABLED=false
BEAUTY_BOT_AI_DECISION_FALLBACK_ENABLED=true
BEAUTY_BOT_AI_MODEL=gpt-5.4-mini
BEAUTY_BOT_AI_TIMEOUT_SECONDS=20
OPENAI_API_KEY=
# Prompt local para decision conversacional. Normalmente no hace falta cambiarlo.
# Las reglas se cargan desde el classpath y el contexto se envia por separado.
BEAUTY_BOT_AI_DECISION_PROMPT_RESOURCE=classpath:prompts/ai-decision-prompt.txt
# Opcional: in_memory (default OpenAI) o 24h
BEAUTY_BOT_AI_PROMPT_CACHE_RETENTION=

# =========================
# Conversation reuse windows
# =========================
BEAUTY_BOT_CONVERSATION_COLLECTING_REUSE_HOURS=24
BEAUTY_BOT_CONVERSATION_READY_FOR_HUMAN_REUSE_HOURS=168
BEAUTY_BOT_CONVERSATION_HUMAN_HANDOFF_REUSE_HOURS=168

# =========================
# WhatsApp Cloud API (Meta)
# =========================
WHATSAPP_ENABLED=true
# Diagnostico temporal: expone telefonos y contenido de conversaciones en logs.
BEAUTY_BOT_WHATSAPP_LOG_PAYLOADS=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BASE_URL=https://graph.facebook.com/v25.0
BEAUTY_BOT_ADVISOR_NOTIFICATION_ENABLED=true
BEAUTY_BOT_ADVISOR_NOTIFICATION_PHONE_NUMBER=

# Desde v2.3.0 el flujo conversacional no consulta calendarios externos.
